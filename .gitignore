# ─── Yarn ────────────────────────────────────────────────────────────────────
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Firebase Emulator ────────────────────────────────────────────────────────
# Local emulator seed data – never commit, it's machine-specific dev state
firebase/suite/

# Firebase debug / runtime logs
*-debug.log*

# ─── Firebase Functions ───────────────────────────────────────────────────────
# Artifacts from TypeScript compilation
firebase/functions/lib/

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.agents/
.idea/

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.local
*.log
.expo/

# ─── Env files ────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
